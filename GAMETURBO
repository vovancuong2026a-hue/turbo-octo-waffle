-- TỶ LỆ PHẦN TRĂM RAM KHÁC BIỆT CHO TỪNG KHẤC
local R1_Weights = {{ram = 15, w = 100}, {ram = 16, w = 90}, {ram = 17, w = 80}, {ram = 18, w = 70}, {ram = 19, w = 60}, {ram = 20, w = 50}}
local R2_Weights = {{ram = 20, w = 100}, {ram = 21, w = 90}, {ram = 22, w = 80}, {ram = 23, w = 70}, {ram = 24, w = 60}, {ram = 25, w = 50}}
local R3_Weights = {{ram = 25, w = 100}, {ram = 26, w = 90}, {ram = 27, w = 80}, {ram = 28, w = 70}, {ram = 29, w = 60}, {ram = 30, w = 50}}

local function GetWeightedRam(node)
    local targetList = R1_Weights
    if node == 2 then targetList = R2_Weights elseif node == 3 then targetList = R3_Weights end
    local totalWeight = 0
    for _, item in ipairs(targetList) do totalWeight = totalWeight + item.w end
    local rolled = math.random(1, totalWeight)
    local sum = 0
    for _, item in ipairs(targetList) do
        sum = sum + item.w
        if rolled <= sum then return "RAM: " .. item.ram .. "%" end
    end
    return "RAM: 23%"
end

