-- HỆ THỐNG LƯU TRỮ VÀ LOGIC HOẠT ĐỘNG CHÍNH
-- ============================================================
local function SaveAllData()
    if writefile then
        local tState = IsTurboOn and "ON" or "OFF"
        local lockState = IsRamLocked and "LOCKED" or "UNLOCKED"
        writefile("GameTurboConfig.txt", tState .. "|" .. CurrentSliderNode .. "|" .. B3.Text .. "|" .. lockState)
    end
end

-- ĐỌC CẤU HÌNH LƯU TRỮ CŨ ĐỂ KHÔI PHỤC PHIÊN CHƠI trước đó
if readfile and isfile and isfile("GameTurboConfig.txt") then
    local savedData = readfile("GameTurboConfig.txt")
    local dataParts = string.split(savedData, "|")
    if dataParts[1] == "ON" then
        IsTurboOn = true
        B1.Text = "HIỆU NĂNG: ON" B1.BackgroundColor3 = Color3.fromRGB(40, 180, 70)
        F30.Text = "TẦN SỐ: 30Hz ✅" F30.TextColor3 = Color3.fromRGB(0, 255, 150)
        task.spawn(function() task.wait(1) ApplySuperOptimization(true) end)
    end
    if dataParts[2] then CurrentSliderNode = tonumber(dataParts[2]) or 1 end
    if dataParts[3] then B3.Text = dataParts[3] end
    if dataParts[4] and dataParts[4] == "LOCKED" then IsRamLocked = true end
    SnapToNode(CurrentSliderNode)
else
    B3.Text = "XEM RAM" SnapToNode(1)
end

-- Bấm nút vuông ▫️ trực tiếp
local function ConnectNodeClick(button, nodeNum)
    button.MouseButton1Click:Connect(function()
        if not IsRamLocked then
            CurrentSliderNode = nodeNum
            SnapToNode(CurrentSliderNode)
            SaveAllData()
        end
    end)
end
