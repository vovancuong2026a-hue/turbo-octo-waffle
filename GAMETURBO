local OriginalSettings = {}
local BorderConnections = {}

local function ApplySuperOptimization(enable)
    local l = game:GetService("Lighting")
    local w = game:GetService("Workspace")
    
    local function OptimizePart(v)
        pcall(function()
            if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Trail") then
                v.Enabled = not enable
            end
            if v:IsA("BasePart") then
                if enable then
                    if not OriginalSettings[v] then
                        OriginalSettings[v] = {Material = v.Material, CastShadow = v.CastShadow, Transparency = v.Transparency}
                    end
                    v.Material = Enum.Material.SmoothPlastic
                    v.CastShadow = false
                    local name = string.lower(v.Name)
                    if string.find(name, "leaf") or string.find(name, "leave") or string.find(name, "grass") or string.find(name, "tree") or string.find(name, "flower") or string.find(name, "cay") or string.find(name, "co") or string.find(name, "la") then
                        v.Transparency = 1 
                        v.CanCollide = false
                    end
                else
                    if OriginalSettings[v] then
                        v.Material = OriginalSettings[v].Material
                        v.CastShadow = OriginalSettings[v].CastShadow
                        v.Transparency = OriginalSettings[v].Transparency
                    end
                end
            end
            if v:IsA("MeshPart") or v:IsA("SpecialMesh") then
                if enable then v.RenderFidelity = Enum.RenderFidelity.Performance end
            end
        end)
    end

    if enable then
        OriginalSettings.FogEnd = l.FogEnd
        OriginalSettings.GlobalShadows = l.GlobalShadows
        OriginalSettings.ClockTime = l.ClockTime
        l.FogEnd = 9e9
        l.GlobalShadows = false
        l.ClockTime = 14
        if w:FindFirstChildOfClass("Terrain") then
            local t = w:FindFirstChildOfClass("Terrain")
            OriginalSettings.Terrain = {Size = t.WaterWaveSize, Speed = t.WaterWaveSpeed, Ref = t.WaterReflectance}
            t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency = 0, 0, 0, 0
        end
        for _, v in ipairs(w:GetDescendants()) do OptimizePart(v) end
        BorderConnections.Added = w.DescendantAdded:Connect(function(v)
            task.wait(0.1) OptimizePart(v)
        end)
    else
        if BorderConnections.Added then BorderConnections.Added:Disconnect() BorderConnections.Added = nil end
        l.FogEnd = OriginalSettings.FogEnd or 1000
        l.GlobalShadows = OriginalSettings.GlobalShadows or true
        l.ClockTime = OriginalSettings.ClockTime or 12
        if w:FindFirstChildOfClass("Terrain") and OriginalSettings.Terrain then
            local t = w:FindFirstChildOfClass("Terrain")
            t.WaterWaveSize = OriginalSettings.Terrain.Size
            t.WaterWaveSpeed = OriginalSettings.Terrain.Speed
            t.WaterReflectance = OriginalSettings.Terrain.Ref
        end
        for _, v in ipairs(w:GetDescendants()) do OptimizePart(v) end
        OriginalSettings = {}
    end
end

local function SaveAllData()
    if writefile then
        local tState = IsTurboOn and "ON" or "OFF"
        local lockState = IsRamLocked and "LOCKED" or "UNLOCKED"
        writefile("GameTurboConfig.txt", tState .. "|" .. CurrentSliderNode .. "|" .. B3.Text .. "|" .. lockState)
    end
end

if readfile and isfile and isfile("GameTurboConfig.txt") then
    local savedData = readfile("GameTurboConfig.txt")
    local dataParts = string.split(savedData, "|")
    if dataParts[1] == "ON" then
        IsTurboOn = true
        B1.Text = "HIEU NANG: ON" B1.BackgroundColor3 = Color3.fromRGB(40, 180, 70)
        F30.Text = "TAN SO: 30Hz V" F30.TextColor3 = Color3.fromRGB(0, 255, 150)
        task.spawn(function() task.wait(1) ApplySuperOptimization(true) end)
    end
    if dataParts[2] then CurrentSliderNode = tonumber(dataParts[2]) or 1 end
    if dataParts[3] then B3.Text = dataParts[3] end
    if dataParts[4] and dataParts[4] == "LOCKED" then IsRamLocked = true end
    SnapToNode(CurrentSliderNode)
else
    B3.Text = "XEM RAM" SnapToNode(1)
end

local function ConnectNodeClick(button, nodeNum)
    button.MouseButton1Click:Connect(function()
        if not IsRamLocked then CurrentSliderNode = nodeNum SnapToNode(CurrentSliderNode) SaveAllData() end
    end)
end
